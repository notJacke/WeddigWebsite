# Copy to .env.local and fill in. .env.local is ignored by git.

# Public values, built into the website.
# Supabase dashboard > Project Settings > API. Use the publishable / anon key only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# The address the site is published at, used for social-sharing links. No trailing slash.
EXPO_PUBLIC_SITE_URL=https://your-wedding-domain.example

# Private. Only used by `npm run export:rsvps` on your own computer.
# Never prefix this with EXPO_PUBLIC_, which would publish it in the website.
SUPABASE_SERVICE_ROLE_KEY=
